a <- 0
b <- 1
n <- 5
dx <- (b-a)/n
xs <- a + (1:n)*dx
dx
xs
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), f(c(xs[i], xs[i+1], xs[i+1], xs[i])))
f <- function(x) x^2
plot(f, xlim=c(-5, 5), ylim=c(-5, 5), las=1, lwd=2)
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), f(c(xs[i], xs[i+1], xs[i+1], xs[i])))
i <- 1
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), f(c(xs[i], xs[i+1], xs[i+1], xs[i])))
c(xs[i], xs[i+1], xs[i+1], xs[i])
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), c(0, 0, f(xs[i+1]), f(xs[i+1])))
plot(f, xlim=c(-1, 1), ylim=c(-1, 1), las=1, lwd=2)
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), c(0, 0, f(xs[i+1]), f(xs[i+1])))
xs
xs <- a + (0:(n-1))*dx
f <- function(x) x^2
plot(f, xlim=c(-1, 1), ylim=c(-1, 1), las=1, lwd=2)
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), c(0, 0, f(xs[i+1]), f(xs[i+1])))
for(i in 1:n){
polygon(c(xs[i], xs[i+1], xs[i+1], xs[i]), c(0, 0, f(xs[i+1]), f(xs[i+1])))
}
