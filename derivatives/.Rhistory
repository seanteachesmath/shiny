f <- function(x) x^3 - 3*x^2 + 2*x
plot(f, xlim=c(-1, 3), ylim = c(-3, 3), las=1)
a <- (3 - sqrt(3))/3
b <- (3 + sqrt(3))/3
points(c(a, b), f(c(a, b)), pch=19, col=2)
a <- 1
points(c(a), f(a), pch=19, col=4)
legend("topleft", c("Function", "Critical point(s)", "Inflection point(s)"), lty=c(1, NA, NA), pch=c(NA, 19, 19), col=c(1, 2, 4))
