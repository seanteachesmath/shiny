dat <- read.delim("~/Dropbox/R Class 2025/selman-trapping.csv", sep = ",", header = TRUE, na.strings = "")
dat <- dat[, 1:87] ## this will drop empty columns
dat <- dat[dat$Species.ID != "", ] ## this will drop empty Species.ID
## converts entries in date columns to trap numbers (as numbers)
for(i in 16:ncol(dat))dat[, i] <- as.numeric(dat[, i])
#### long dates
tmp <- NULL
## over each row (i.e., individual) in the original data
## goal is to make its date columns in to rows
for(i in 1:nrow(dat)){
## field data
(info <- dat[i, 1:15])
## trapping dates
(dates <- (dat[i, 16:ncol(dat)]))
## convert to long
(traps <- cbind(Date = (names(dates)), Trap = t(dates), row.names = NULL))
## drop annoying row names
rownames(traps) <- NULL
(traps <- as.data.frame(traps))
## name for convenience
(names(traps) <- c("Date", "Trap"))
## drop missed captures, this is tricky and needs to be revisited for any attempts at CMR
## to do CMR analyses we'd need to know the opportunities an individual had to be captured
## this means the combinations of dates and webs that can be created but would
## need to be checked against field notes
(traps <- traps[!is.na(traps$Trap) & traps$Trap != "", ])
## attach a column of date of trapping and trap number to an individuals field recordings
## recordings will be duplicated from first capture to subsequent captures
## by comparing to notes some of these could be updated in subsequent captures
if(dim(info)[1] <= dim(traps)[1])(tmp2 <- cbind(info, traps, row.names = NULL))
## accumulate animal by animal
tmp <- rbind(tmp, tmp2)
}
####
tmp <- as.data.frame(tmp)
tmp$Date <- gsub("X","", tmp$Date)
tmp$Date <- as.Date(tmp$Date, "%d.%b.%y")
head(tmp)
for(i in c(1, 6:10, 17)) tmp[, i] <- as.numeric(as.vector(tmp[, i]))
for(i in c(2, 3, 4, 5, 12:15)) tmp[, i] <- as.factor(tmp[, i])
summary(tmp)
## Checks
# first tabulate the number of times an S.Number showed up in the row-duplicated data
# now trapping dates are rows not columns so S.Numbers should repeat (and match whatever id information is given in the original)
# The inner table counts up the frequencies of each S.Number
# The outer table counts up how many times a given number of captures were recorded
# e.g. most animals were recorded once, about 400 were recorded t20ce, one was seemingly recorded 12 times!
table(table(tmp[, c("S.Number")]))
plot(table(table(tmp[, c("S.Number")])), xlim = c(0, 15))
## ignoring NAs, sum over the *original* dats to see how often each S.Number row has captures recorded
sum2 <- function(x) sum(x, na.rm = TRUE)
tab <- apply(sign(dat[, 16:ncol(dat)]), 1, sum2)
table(tab)
lines(table(tab), col = 2)
mtext("Frequencies of encounter totals", 3)
## two animals dropped from trapping
dat[619, ]
dat[1024, ]
## search for dates in comments
## a bit more complicated due to variations in format
## dates of form XX-Mon-YY
dates1 <- grep("[0-9][0-9]-[A-Z][a-z][a-z]-[0-9][0-9]", dat$Comments, ignore.case = TRUE)
## dates of form X-Mon-YY
dates1 <- c(dates1, grep("[0-9]-[A-Z][a-z][a-z]-[0-9][0-9]", dat$Comments, ignore.case = TRUE))
## dates of form XXMonYY
dates2 <- grep("[0-9][0-9][A-Z][a-z][a-z][0-9][0-9]", dat$Comments, ignore.case = TRUE)
## dates of form XMonYY
dates2 <- c(dates2, dates2 <- grep("[0-9][A-Z][a-z][a-z][0-9][0-9]", dat$Comments, ignore.case = TRUE))
dates3 <- grep("[0-9][0-9]-[A-Z][a-z][a-z][a-z]-[0-9][0-9]", dat$Comments, ignore.case = TRUE)
dates4 <- grep("[0-9][0-9]/[0-9][0-9]/[0-9][0-9]", dat$Comments, ignore.case = TRUE)
## dates in comments
dic <- dat[c(dates1, dates2, dates3, dates4), ]
dic$Comments
dic[250, ]
dat[dat$S.Number == 706, ]
names(tmp)
tmp[tmp$S.Number == 706, ]
## no dates in comments
ndic <- dat[-c(dates1, dates2, dates3, dates4), ]
ndic$Comments[ndic$Comments != ""]
## I don't know why I picked animal 902, but it had a misspelled comment word
dat[902, ]
