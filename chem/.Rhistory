knitr::opts_chunk$set(echo = TRUE)
library(stringr)
dat <- read.delim("fig4.csv", sep = ',')
head(dat)
ecs <- str_split(dat$Experimental.Criteria, " ")
ecs.dat <- c(dilution = ecs[[1]][1], concentration = ecs[[1]][2], light = paste(ecs[[1]][3], ecs[[1]][4]))
for(i in 2:nrow(dat)){
ecs.dat <- rbind(ecs.dat, c(dilution = ecs[[i]][1], concentration = ecs[[i]][2], light = paste(ecs[[i]][3], ecs[[i]][4])))
}
ecs.dat <- as.data.frame(ecs.dat)
dat <- cbind(dat[, 1:2], ecs.dat, dat[, 3:ncol(dat)])
for(i in 2:5)dat[, i] <- as.factor(dat[, i])
# levels(dat$light)
dat$light <- factor(dat$light, levels = c("0s Light", "30s Light", "180s Light", "300s Light", "600s Light", "Light On"))
# levels(dat$dilution)
dat$dilution <- factor(dat$dilution, levels = rev(c("1-100", "1-300", "1-1000", "1-2000", "1-3000")))
dat$true.dilution <- as.vector(dat$dilution)
dat[dat$true.dilution == "1-100", "true.dilution"] <- 4.55*10^10
dat[dat$true.dilution == "1-300", "true.dilution"] <- 1.52*10^10
dat[dat$true.dilution == "1-1000", "true.dilution"] <- 4.55*10^9
dat[dat$true.dilution == "1-2000", "true.dilution"] <- 2.27*10^9
dat[dat$true.dilution == "1-3000", "true.dilution"] <- 1.52*10^9
dat$true.dilution <- as.numeric(as.vector(dat$true.dilution))
# levels(dat$concentration)
dat$concentration <- factor(dat$concentration, levels = c("0.7U/mL", "1.0U/mL", "2.0U/mL"))
tab <- as.data.frame(table(dat[, c("dilution", "concentration", "light")]))
(tab <- tab[tab$Freq>0,])
sum2 <- function(x) sum(x, na.rm=T)
tab2 <- apply(dat[, 6:ncol(dat)], 2, sum2)
t(tab2)
rownames(dat) <- NULL
## figure 4b
par(mfrow = c(1,1), xaxs = 'i', yaxs = 'r', mar=c(8.1, 5.1, 1.1, 1.1))
mn <- median(log10(dat$true.dilution))
plot(I(Remaining.Fibers.due.to.Bundling/Total.Remaining.Fibers) ~ jitter(log10(true.dilution) - mn), dat, subset = ((concentration == "1.0U/mL") & (light == "Light On")), las = 1, pch=19, col="red", xlim = c(9, 11) - mn, axes=F, xlab="", ylab = "")
axis(1, at = log10(c(1.52*10^9, 2.27*10^9, 4.55*10^9, 1.52*10^10, 4.55*10^10)) - mn, c(expression(1.52), expression(2.27),expression(4.55),expression(1.52),expression(4.55)), las = 1, hadj = 0.5)
axis(1, at = log10(c(1.52*10^9, 2.27*10^9, 4.55*10^9, 1.52*10^10, 4.55*10^10)) - mn, c(expression(""%*%10^{9}), expression(""%*%10^{9}),expression(""%*%10^{9}),expression(""%*%10^{10}),expression(""%*%10^{10})), las = 1, padj = 1.1)
axis(2, (0:5)/5, 100*(0:5)/5, las=1)
box()
mtext("Percent remaining", 2, line=3, font=2, cex=1.5)
mtext("Bead Concentration (log scale)", 1, line = 6, font = 2, cex = 1.5)
points(I(Bundled.and.Elongated/Total.Remaining.Fibers) ~ jitter(log10(true.dilution) - mn), dat, subset = ((concentration == "1.0U/mL") & (light == "Light On")), las = 1, pch=19, col="lightblue")
points(I(Elongated.Without.Bundling/Total.Remaining.Fibers) ~ jitter(log10(true.dilution) - mn), dat, subset = ((concentration == "1.0U/mL") & (light == "Light On")), las = 1, pch=19, col="gold")
rem <- lm(I(Remaining.Fibers.due.to.Bundling/Total.Remaining.Fibers) ~ I(log10(true.dilution) - mn), dat, subset = ((concentration == "1.0U/mL") & (light == "Light On")))
abline(rem, las = 1, pch=19, col="red", lwd = 2)
be <- lm(I(Bundled.and.Elongated/Total.Remaining.Fibers) ~ I(log10(true.dilution) - mn), dat, subset = ((concentration == "1.0U/mL") & (light == "Light On")))
abline(be, las = 1, pch=19, col="lightblue", lwd = 2)
ewb <- lm(I(Elongated.Without.Bundling/Total.Remaining.Fibers) ~ I(log10(true.dilution) - mn), dat, subset = ((concentration == "1.0U/mL") & (light == "Light On")))
abline(ewb, las = 1, pch=19, col="gold", lwd = 2)
legend("topright", c("% remaining due to bundling", "% elongated and bundled", "% elongated without bundling"), col = c("red", "lightblue", "gold"), lwd = 2, pch = 19, merge = T)
## raw output for Remaining.Fibers.due.to.Bundling/Total.Remaining.Fibers
summary(rem)
## raw output for Bundled.and.Elongated/Total.Remaining.Fibers
summary(be)
## raw output for Elongated.Without.Bundling/Total.Remaining.Fibers
summary(ewb)
## figure 4c
par(mfrow = c(1, 1), xaxs = 'i', yaxs = 'r', mar=c(5.1, 5.1, 1.1, 1.1))
mn <- median(as.numeric(substr(dat$concentration, 1, 3)))
dat$true.concentration <- as.numeric(substr(dat$concentration, 1, 3))
plot(I(Remaining.Fibers.due.to.Bundling/Total.Remaining.Fibers) ~ jitter(true.concentration - mn), dat, subset = ((dilution == "1-1000") & (light == "Light On")), las = 1, pch=19, col="red", xlim = c(0.7, 2) - mn, axes=F, xlab="", ylab = "")
points(I(Bundled.and.Elongated/Total.Remaining.Fibers) ~ jitter(true.concentration - mn), dat, subset = ((dilution == "1-1000") & (light == "Light On")), las = 1, pch=19, col="lightblue")
points(I(Elongated.Without.Bundling/Total.Remaining.Fibers) ~ jitter(true.concentration - mn), dat, subset = ((dilution == "1-1000") & (light == "Light On")), las = 1, pch=19, col="gold")
axis(1, c(0.7, 1.0, 2.0)-mn, paste(c(0.7, 1.0, 2.0), "U/mL"), las=1)
axis(2, (0:5)/5, 100*(0:5)/5, las=1)
box()
mtext("Percent remaining", 2, line=3, font=2, cex=1.5)
mtext("Concentration", 1, line=3, font=2, cex=1.5)
rem <- lm(I(Remaining.Fibers.due.to.Bundling/Total.Remaining.Fibers) ~ (true.concentration - mn), dat, subset = ((dilution == "1-1000") & (light == "Light On")))
