# Define UI for application that draws a histogram
ui <- fluidPage(
# Application title
titlePanel("Predator-Prey Dynamics"),
# Sidebar with a slider input for number of bins
sidebarLayout(
sidebarPanel(
withMathJax(helpText("The standard predator-prey model is given by \\begin{align*}\\dfrac{dH}{dt} & = \\alpha H - \\beta HL\\\\\\dfrac{dL}{dt} & = \\gamma HL - \\delta L\\end{align*} with an initial condition \\(x_0\\) and choice of parameter \\(r\\). The bottom graph is a rendition of what is called 'a solution in the phase plane'.")),
sliderInput("H0",
withMathJax(helpText("Initial Prey, \\(H_0 = \\)")),
min = 0,
max = 500,
value = 30,
step = 5),
sliderInput("L0", withMathJax(helpText("Initial Predator, \\(L_0 = \\)")),
min = 0,
max = 500,
value = 30,
step = 5),
sliderInput("alpha",
withMathJax(helpText("\\(\\alpha = \\)")),
min = 0,
max = 2,
value = 1.1,
step = 0.1),
sliderInput("beta",
withMathJax(helpText("\\(\\beta = \\)")),
min = 1e-10,
max = 0.5,
value = 0.05,
step = 0.01),
sliderInput("1e-10",
withMathJax(helpText("\\(\\gamma\\) (keep less than \\(\\beta\\)) \\(=\\)")),
min = 0,
max = 0.5,
value = 0.01,
step = 0.01),
sliderInput("delta",
withMathJax(helpText("\\(\\delta = \\)")),
min = 1e-10,
max = 2,
value = 0.5,
step = 0.01),
),
# Show a plot of the generated distribution
mainPanel(plotOutput("plot1"))
)
)
